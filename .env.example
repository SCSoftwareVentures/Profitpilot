NODE_ENV=development
PORT=8080
# Replace this password with the same POSTGRES_APP_PASSWORD value below.
DATABASE_URL=postgres://profitpilot_app:replace-with-runtime-password@localhost:5432/profitpilot
# Local development may use false. Production startup requires DATABASE_SSL=true with a trusted certificate chain.
DATABASE_SSL=false
CORS_ORIGIN=http://localhost:8080
AUTH_ISSUER=https://your-identity-provider.example/
AUTH_AUDIENCE=profitpilot-api
AUTH_JWKS_URL=https://your-identity-provider.example/.well-known/jwks.json
MAX_UPLOAD_BYTES=1048576

# Generate unique values; passwords and signing key should be 32+ random bytes encoded as hex.
POSTGRES_ADMIN_PASSWORD=replace-with-64-hex-character-admin-password
POSTGRES_APP_PASSWORD=replace-with-64-hex-character-runtime-password
TENANT_CONTEXT_HMAC_SECRET=replace-with-a-different-64-hex-character-signing-key

# Required for any production MFA-protected endpoint, with provider-verified semantics.
AUTH_STEP_UP_ACR=urn:your-provider:step-up
AUTH_STEP_UP_MAX_AGE_SECONDS=300
TENANT_CONTEXT_HMAC_KEY_ID=primary
# Production rejects generic JWT token types; provider must supply RFC 9068 access tokens.
# Never put operator/admin/recovery credentials in the production API environment.

# Production only: externally reviewed, independently signed release evidence. No defaults permit release.
# PROFITPILOT_DEPLOYMENT_ID=approved-deployment
# PROFITPILOT_RELEASE_APPROVAL_FILE=/run/profitpilot/release-approval.json
# PROFITPILOT_TECHNICAL_APPROVAL_PUBLIC_KEY=<base64url Ed25519 SPKI DER>
# PROFITPILOT_PRIVACY_APPROVAL_PUBLIC_KEY=<different base64url Ed25519 SPKI DER>
